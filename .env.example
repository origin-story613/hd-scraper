# Copy this file to .env and adjust as needed.

# Where deal data is stored (SQLite file path)
DATABASE_URL=sqlite:///./deals.db

# Comma-separated list of Home Depot ZIP codes to check clearance pricing for.
# Home Depot clearance pricing is store-specific, so more ZIPs = more coverage
# (but more scrape time). Example covers a spread of regions.
HD_ZIP_CODES=10001,60601,90001,30301

# Search terms / category paths that get scanned every run. See
# app/scraper/targets.py for the full list and how to add more.
# Leave as-is unless you want to customize what gets scanned.

# Seconds to wait between page loads (be a good citizen, avoid hammering HD)
REQUEST_DELAY_SECONDS=3

# Run the browser headless (true) or show it (false, useful for debugging
# when Home Depot's page layout changes and the scraper needs fixing)
HEADLESS=true

# Only keep/show deals at or above this discount percentage
MIN_DISCOUNT_PERCENT=20

LOG_LEVEL=INFO
